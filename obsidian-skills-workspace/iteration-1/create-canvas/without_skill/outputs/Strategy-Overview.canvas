		{"id":"signal_generation","type":"text","text":"# Signal Generation\n\nProduces buy/sell signals from market data using ML models (XGBoost + Platt calibration). Ingests OHLCV candles and technical indicators to output probability-scored trading signals.","x":-400,"y":0,"width":280,"height":200,"color":"4"},
